// Read-only diagnostics. These hooks never invoke get_model, check, internalize,
// mark_as_relevant, RNG, or create a logical assertion.
void context::S_watch(unsigned v,a2::Json a){if(!m_S||m_S->watches.size()>=12)return;auto* e=bool_var2expr(v);auto const& d=get_bdata(v);a["atom_kind"]=d.is_eq()?"equality":d.is_theory_atom()?"theory_atom":m.is_bool(e)&&is_app(e)&&to_app(e)->get_family_id()==null_family_id?"Bool":"gate_or_other";a["is_atom"]=d.is_atom();a["is_enode"]=d.is_enode();a["relevancy_level"]=relevancy_lvl();a["relevant_before"]=is_relevant(e);m_S->add(v,e,m_A->ordinal,std::move(a));m_S->watches.back().relevant=is_relevant(e);}
void context::S_event(unsigned v,char const* kind,int truth){if(!m_S)return;for(unsigned i=0;i<m_S->watches.size();++i){auto& w=m_S->watches[i];if(w.var!=v||v>=get_num_bool_vars()||bool_var2expr(v)!=w.atom)continue;int rel=is_relevant(w.atom);if(rel!=w.relevant){m_S->event(i,"relevance_changed",m_scope_lvl,m_assigned_literals.size(),-1,rel);w.relevant=rel;}m_S->event(i,kind,m_scope_lvl,m_assigned_literals.size(),truth,rel);}}
void context::S_assignment(literal l,bool popped,bool decision){if(!m_S)return;auto fresh=popped?0:++m_S->serial;for(unsigned i=0;i<m_S->watches.size();++i){auto& w=m_S->watches[i];if(w.var!=l.var()||bool_var2expr(l.var())!=w.atom)continue;if(popped){m_S->event(i,"assignment_withdrawn",m_scope_lvl,m_assigned_literals.size(),!l.sign(),is_relevant(w.atom));w.active=false;}else{w.token=fresh;w.active=true;m_S->event(i,decision?"assignment_decision":"assignment_propagation",m_scope_lvl,m_assigned_literals.size(),!l.sign(),is_relevant(w.atom));}}}
void context::S_sample(char const* kind){if(!m_S)return;for(auto& w:m_S->watches)if(w.var<get_num_bool_vars()&&bool_var2expr(w.var)==w.atom){auto value=get_assignment(w.var);S_event(w.var,kind,value==l_undef?-1:value==l_true);}}
void context::S_cause(unsigned v){if(!m_S)return;m_S->causal_watch=~0u;for(unsigned i=0;i<m_S->watches.size();++i)if(m_S->watches[i].var==v)m_S->causal_watch=i;}
void context::S_theory(unsigned th,unsigned a,unsigned b,bool eq,bool delivered){if(!m_S)return;auto key=std::make_tuple(th,a,b,eq);if(!delivered){if(m_S->causal_watch==~0u)return;if(m_S->theory_causes.size()>=8192){m_S->overflow=true;return;}auto i=m_S->causal_watch;m_S->theory_causes[key].push_back({i,m_S->watches[i].token});m_S->event(i,eq?"theory_equality_queued":"theory_disequality_queued",m_scope_lvl,m_assigned_literals.size());}else{auto it=m_S->theory_causes.find(key);if(it==m_S->theory_causes.end())return;for(auto [i,token]:it->second)if(m_S->watches[i].token==token&&m_S->watches[i].active)m_S->event(i,eq?"theory_equality_delivered":"theory_disequality_delivered",m_scope_lvl,m_assigned_literals.size());m_S->theory_causes.erase(it);}}
void context::S_model(model* mdl){auto s=m_S?m_S:m_S_pending;if(!s||!mdl)return;S_sample("relevance_before_model");auto run=s->run.lock();if(!run)return;s->flush();s->model_layer(mdl,"M_leaf",s->backend,"leaf:"+std::to_string(s->backend));std::lock_guard<std::recursive_mutex> lock(run->mutex);run->semantic_provider=s->backend;run->semantic_chain="direct:"+std::to_string(s->backend);if(reinterpret_cast<uintptr_t>(&m)==run->semantic_manager){bool found=false;for(auto const& p:run->semantic_snapshots)if(p.get()==s.get())found=true;if(!found)run->semantic_snapshots.push_back(s);}m_S_pending.reset();}

unsigned context::semantic_backend_id() const {auto s=m_S?m_S:m_S_pending;return s?s->backend:0;}
