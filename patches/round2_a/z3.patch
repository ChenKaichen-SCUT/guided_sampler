+   out.kind="exact_linear_equivalence";
+  }else {out.key="EX:"+out.exact;out.kind="exact_structure";}
+  out.complete=true;
+ }catch(std::runtime_error const& ex){out.reason=ex.what();out.key.clear();out.complete=false;}
